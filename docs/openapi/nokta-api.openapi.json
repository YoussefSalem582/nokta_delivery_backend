  "info": {
    "title": "Nokta API",
    "description": "Ride-hailing and delivery platform API for Egypt. Supports riders, drivers, couriers, and admins.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    },
    {
      "url": "https://api.nokta.app",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "in": "header"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ahmed Hassan"
          },
          "email": {
            "type": "string",
            "example": "ahmed@example.com"
          },
          "phone": {
            "type": "string",
